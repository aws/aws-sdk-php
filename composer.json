{
    "name": "aws/aws-sdk-php-v4",
    "description": "AWS SDK for PHP V4",
    "type": "library",
    "license": "Apache-2.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "smithy/smithy-php": "dev-main as 0.1.x-dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Aws\\Codegen\\": "codegen/src/",
            "Aws\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aws\\Codegen\\Tests\\": "codegen/tests/",
            "Aws\\Tests\\": "tests/",
            "Smithy\\Tests\\Utils\\": "vendor/smithy/smithy-php/tests/Utils/"
        }
    },
    "bin": [
        "codegen/bin/aws-php-codegen"
    ],
    "scripts": {
        "test": "phpunit",
        "license:check": "php tools/check-license-headers.php",
        "static-analysis": "sh -c 'if find src codegen/src -type f -name \"*.php\" 2>/dev/null | grep -q .; then phpstan analyse --no-progress; else echo \"static-analysis: no PHP source yet; skipping.\"; fi'"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/smithy-lang/smithy-php"
        }
    ]
}
