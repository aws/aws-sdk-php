{
    "name": "aws/aws-sdk-php-v4",
    "description": "AWS SDK for PHP V4",
    "type": "library",
    "license": "Apache-2.0",
    "minimum-stability": "RC",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "smithy/auth": "^0.1",
        "smithy/client": "^0.1",
        "smithy/core": "^0.1",
        "smithy/http": "^0.1",
        "smithy/protocol": "^0.1",
        "smithy/protocol-aws": "^0.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.0",
        "smithy/async": "^0.1",
        "smithy/codegen": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Aws\\Codegen\\": "codegen/src/",
            "Aws\\Core\\Credentials\\": "src/Credentials/",
            "Aws\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aws\\Codegen\\Tests\\": "codegen/tests/",
            "Aws\\Tests\\": "tests/"
        }
    },
    "bin": [
        "codegen/bin/aws-php-codegen"
    ],
    "scripts": {
        "test": "phpunit",
        "license:check": "php tools/check-license-headers.php",
        "static-analysis": "sh -c 'if find src codegen/src -type f -name \"*.php\" 2>/dev/null | grep -q .; then phpstan analyse --no-progress; else echo \"static-analysis: no PHP source yet; skipping.\"; fi'"
    }
}
