{
  "version": "1.0",
  "examples": {
    "BatchWriteRecord": [
      {
        "input": {
          "Entries": [
            {
              "FeatureGroupName": "my-feature-group",
              "Record": [
                {
                  "FeatureName": "customer_id",
                  "ValueAsString": "cust-001"
                },
                {
                  "FeatureName": "age",
                  "ValueAsString": "25"
                }
              ]
            }
          ]
        },
        "output": {
          "Errors": [],
          "UnprocessedEntries": []
        },
        "id": "batch-write-record-example-1",
        "title": "Write records to multiple feature groups"
      }
    ],
    "ListRecords": [
      {
        "input": {
          "FeatureGroupName": "my-feature-group",
          "MaxResults": 10
        },
        "output": {
          "NextToken": "eyJsYXN0RXZhbHVhdGVkS2V5IjoiYWJjMTIzIn0=",
          "RecordIdentifiers": [
            "record-id-1",
            "record-id-2"
          ]
        },
        "id": "list-records-example-1",
        "title": "List record identifiers from a feature group"
      }
    ],
    "UpdateRecord": [
      {
        "input": {
          "FeatureGroupName": "my-feature-group",
          "Features": [
            {
              "FeatureName": "age",
              "ValueAsString": "26"
            },
            {
              "FeatureName": "membership_tier",
              "ValueAsString": "gold"
            },
            {
              "FeatureName": "event_time",
              "ValueAsString": "2026-07-26T12:00:00Z"
            }
          ],
          "RecordIdentifierValueAsString": "cust-001"
        },
        "output": {},
        "id": "update-record-example-1",
        "title": "Update specific features in a record"
      },
      {
        "input": {
          "FeatureGroupName": "my-feature-group",
          "Features": [
            {
              "FeatureName": "age",
              "ValueAsString": "26"
            },
            {
              "FeatureName": "event_time",
              "ValueAsString": "2026-07-26T12:00:00Z"
            }
          ],
          "RecordIdentifierValueAsString": "cust-001",
          "TtlDuration": {
            "Unit": "Weeks",
            "Value": 4
          }
        },
        "output": {},
        "id": "update-record-example-2",
        "title": "Update features and set a time-to-live (TTL) duration"
      }
    ]
  }
}
