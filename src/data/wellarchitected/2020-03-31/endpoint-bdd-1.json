            "type": "string"
        },
        "SubServiceType": {
            "required": false,
            "documentation": "Identifies the sub-service used for endpoint routing. This value is set automatically per operation and is not client-configurable. It is unset for Well-Architected Tool operations. It is AGENT for Well-Architected Agent operations, which resolve to the wellarchitected-agent endpoint.",
            "type": "string"
        }
    },
