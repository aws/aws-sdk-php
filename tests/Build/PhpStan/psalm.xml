<?xml version="1.0"?>
<!--
    Psalm config for validating @phpstan-method emission on generated clients.

    From the SDK root:
      vendor/bin/psalm --config=tests/Build/PhpStan/psalm.xml --no-cache

    Expects Psalm >= 5. `@phpstan-method` is read via cross-tag support.
-->
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="false"
    findUnusedCode="false"
>
    <projectFiles>
        <file name="fixture.php" />
        <ignoreFiles>
            <directory name="../../../vendor" />
        </ignoreFiles>
    </projectFiles>
</psalm>
