[
    {
        "type": "api-change",
        "category": "CleanRooms",
        "description": "Adds support for populating intermediate tables with results from PySpark analysis templates."
    },
    {
        "type": "api-change",
        "category": "Braket",
        "description": "Supporting a new PAUSED device status and a DeviceStatusReason."
    },
    {
        "type": "api-change",
        "category": "CognitoIdentityProvider",
        "description": "Add support for restoring user pool's user data to point in time."
    },
    {
        "type": "api-change",
        "category": "IAM",
        "description": "Adds MaxSignInSessionDuration to IAM Roles and Login Profiles, allowing customers to configure the maximum Console sign-in session duration per principal. Affects CreateRole, UpdateRole, GetRole and LoginProfile APIs."
    },
    {
        "type": "api-change",
        "category": "Resiliencehubv2",
        "description": "This release includes support for adding new field for the effective policy used in test runs and documentation updates."
    },
    {
        "type": "api-change",
        "category": "Signin",
        "description": "These APIs enable customers and administrators to list, view, and revoke AWS Sign-In Sessions programmatically using the AWS CLI and SDKs, providing greater visibility and control over authenticated access."
    },
    {
        "type": "enhancement",
        "category": "ElasticLoadBalancingv2",
        "description": "This release adds support for the keyExchange field in CloudTrail tlsDetails, enabling customers to distinguish classical from post-quantum hybrid key exchange for TLS connections on Application Load Balancers."
    },
    {
        "type": "api-change",
        "category": "Neptune",
        "description": "Neptune Database Serverless support for graviton3 based r8g instances."
    },
    {
        "type": "api-change",
        "category": "BedrockAgentCoreControl",
        "description": "Adds s3BucketMount to mount an Amazon S3 bucket as a file system in AgentCore Runtime, with an optional per-session key prefix and adds operatingSystemConfiguration with a Linux privilegeMode (STANDARD or PRIVILEGED) to the capacity provider configuration"
    },
    {
        "type": "api-change",
        "category": "S3",
        "description": "Adds exclusions and Multi-Region key resolution to S3 Replication. Rule filters support a Not element to exclude prefixes and object tags. Destination EncryptionConfiguration supports UseSourceMultiRegionKey to encrypt replicas with the related replica KMS multi-Region key in the destination Region."
    },
    {
        "type": "api-change",
        "category": "WAFV2",
        "description": "Adds the AnalyticsConfig parameter to CreateWebACL and UpdateWebACL to enable or disable cross-Region security analytics for a WebACL. When you enable security analytics, you authorize AWS to transfer and store full request logs outside the AWS Region where the WebACL is hosted."
    },
    {
        "type": "feature",
        "category": "AbuseSignal",
        "description": "This release introduces the AWS Abuse Signal API, enabling customers to programmatically submit and track AWS abuse reports."
    },
    {
        "type": "api-change",
        "category": "SecurityAgent",
        "description": "This release adds support for resuming a paused penetration test job from its last saved checkpoint."
    },
    {
        "type": "api-change",
        "category": "SESv2",
        "description": "This release adds support for Spillover Routing in Amazon SES."
    },
    {
        "type": "api-change",
        "category": "Health",
        "description": "Adds resource tags functionality to the AWS Health service"
    },
    {
        "type": "api-change",
        "category": "Support",
        "description": "Updated endpoint resolution for AWS Support, including FIPS and dual-stack endpoints."
    },
    {
        "type": "api-change",
        "category": "CloudFormation",
        "description": "AWS CloudFormation StackSets now provides stage-by-stage progress for deployments that span thousands of accounts and AWS Regions, which enables you to see where each deployment stands while it runs"
    }
]
