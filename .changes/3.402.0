[
    {
        "type": "api-change",
        "category": "IVSRealTime",
        "description": "Adds RevokeConnectionToken operation for Amazon IVS Real-Time Streaming."
    },
    {
        "type": "enhancement",
        "category": "Lambda",
        "description": "AWS Lambda durable functions now supports payloads up to 1 MB for checkpoints, callback completion, and error details."
    },
    {
        "type": "api-change",
        "category": "KafkaConnect",
        "description": "Amazon MSK Connect now supports pausing and resuming connectors via the asynchronous PauseConnector and ResumeConnector APIs. Paused connectors keep their configuration and committed offsets and resume where they left off. Each call returns an operation ARN to track with DescribeConnectorOperation."
    },
    {
        "type": "api-change",
        "category": "Glue",
        "description": "Add support for large worker types in AWS Glue"
    },
    {
        "type": "api-change",
        "category": "ElementalInference",
        "description": "Elemental Inference now supports feed scheduling, letting you apply feed configuration changes at a time you choose instead of building your own automation."
    },
    {
        "type": "api-change",
        "category": "BedrockAgentCoreControl",
        "description": "Adds model-based routing and fallback to AgentCore Gateway rules. Rules can match the requested model, route to a specific model, and fall back across inference targets with an optional circuit breaker. Adds multi-dimensional rating scales for AgentCore Evaluations LLM-as-a-Judge evaluators."
    },
    {
        "type": "api-change",
        "category": "NetworkManager",
        "description": "AWS Cloud WAN now provides managed one-to-one NAT directly on it's core network attachments, through integration with Regional Private NAT Gateway. Use UpdateAttachmentNatConfiguration to enable NAT and configure NAT rules, and ListAttachmentNatConfigurations to view them."
    },
    {
        "type": "api-change",
        "category": "BedrockAgentCore",
        "description": "Adds the dimension name to evaluation results and batch evaluation summaries. For multi-dimensional LLM-as-a-Judge evaluators, each result and summary now identifies which dimension it corresponds to."
    },
    {
        "type": "api-change",
        "category": "EC2",
        "description": "AWS Transit Gateway now provides managed one-to-one NAT directly on its attachments, through integration with Regional Private NAT Gateway. Use ModifyTransitGatewayAttachmentNatConfiguration to enable NAT and configure NAT rules, and GetTransitGatewayAttachmentNatConfiguration to view them."
    },
    {
        "type": "api-change",
        "category": "Connect",
        "description": "Adds support for customer queryable replication errors."
    },
    {
        "type": "feature",
        "category": "Continuum",
        "description": "Releasing Continuum for Code Vulnerabilities APIs for SDKs"
    },
    {
        "type": "api-change",
        "category": "OpenSearchServerless",
        "description": "Adds APIs to create, get, list, and cancel ingestion jobs, and to create, get, list, and delete ingestion streams, for ingesting data from Amazon S3 into OpenSearch Serverless collections."
    }
]
