[
    {
        "type": "api-change",
        "category": "TaxSettings",
        "description": "Adds support for Norway, New Zealand and United Arab Emirates additional tax information, and the Vietnam VAT credit method and 20-digit payment voucher number."
    },
    {
        "type": "api-change",
        "category": "AgentRegistryControl",
        "description": "Adds APIs to create publishers, verify that a publisher owns a domain, and associate registry records with a publisher. Publishers can approve or reject each association."
    },
    {
        "type": "api-change",
        "category": "SSM",
        "description": "This release adds a CloudProviders field to SSM documents. Specify the cloud providers (AWS, Azure, GCP) a document can run on in CreateDocument and UpdateDocument, view it in DescribeDocument, ListDocuments and ListDocumentVersions, and filter ListDocuments by cloud provider."
    },
    {
        "type": "api-change",
        "category": "DataZone",
        "description": "Amazon DataZone now supports detaching a project from its project profile via UpdateProject, specifying the environment blueprint ID in environment configuration user parameters, and transferring asset ownership from a source project to a target project via UpdateAssetOwner."
    },
    {
        "type": "api-change",
        "category": "MediaLive",
        "description": "AWS Elemental MediaLive now supports converting captions from non-embedded sources, such as Teletext and Smart Subtitles, into CEA-608 and CEA-708 embedded captions, and supports WebVTT subtitle renditions from HLS inputs as a caption source."
    },
    {
        "type": "feature",
        "category": "AgentDiscovery",
        "description": "Adds the SearchPublicRecords API, which searches public registry records for AI agents, tools, and skills that their publishers have made discoverable."
    },
    {
        "type": "api-change",
        "category": "TranscribeService",
        "description": "This release adds the TranscribeAudio API for synchronous transcription. Send a media file inline or from Amazon S3 and receive the transcript in the same response, with support for speaker, channel identification, language identification, custom vocabularies, vocabulary filters, and PII redaction."
    },
    {
        "type": "api-change",
        "category": "DeviceFarm",
        "description": "Add support for the use of virtual devices on Device Farm."
    },
    {
        "type": "api-change",
        "category": "EC2",
        "description": "This release adds documentation for the T9g instance family to the EC2 ModifyDefaultCreditSpecification and GetDefaultCreditSpecification APIs, adds the disable-complete state for IPAM routing policy registrations, and adds Network Firewall automated Internet firewall API changes."
    },
    {
        "type": "api-change",
        "category": "Glue",
        "description": "Minor updates to the Glue Business Context APIs"
    },
    {
        "type": "api-change",
        "category": "Route53",
        "description": "Amazon Route 53 support for advanced hosted zones. Including change guardrails, public dns fallback, change history. Also support for AZAffinityRouting."
    },
    {
        "type": "api-change",
        "category": "FSx",
        "description": "Adds support for FSx for NetApp ONTAP 3rd Generation file systems and API operations for new FSx for NetApp ONTAP resources"
    },
    {
        "type": "api-change",
        "category": "CloudFront",
        "description": "Amazon CloudFront now supports HTTP2 connections to custom and VPC origins, so you can multiplex many requests over fewer origin connections, including WebSocket connections to HTTP2 origins that support extended CONNECT."
    },
    {
        "type": "api-change",
        "category": "Bedrock",
        "description": "Amazon Bedrock adds APIs to manage projects, discover and apply to Trusted Access Programs, manage enrollments, and configure data retention storage for accounts, organizations, and projects. Model and inference profile discovery now supports project context."
    },
    {
        "type": "api-change",
        "category": "PCS",
        "description": "Added support for Instance Health Checks in AWS PCS."
    },
    {
        "type": "api-change",
        "category": "NetworkFirewall",
        "description": "Adds read-only support for internet gateway firewalls, which are created and managed by AWS Network Security Manager. Adds FirewallType to firewall operations and IgwFirewallConfiguration to Firewall."
    },
    {
        "type": "api-change",
        "category": "SageMaker",
        "description": "Adds HyperPod Global Inference Gateway APIs to route inference across HyperPod clusters in multiple Regions. Adds the MoveClusterNodes API, which moves running nodes between instance groups, within a cluster or between clusters in the same region, account and subnet, without releasing the instances."
    },
    {
        "type": "api-change",
        "category": "ObservabilityAdmin",
        "description": "Enablement for Network Firewall and Omni Events via Observability Admin Telemetry Rule for account and organization level"
    },
    {
        "type": "api-change",
        "category": "ElementalInference",
        "description": "Adds Arabic (ara) as a supported language for subtitling transcription and custom vocabulary dictionaries."
    },
    {
        "type": "feature",
        "category": "SageMakerGatewayRuntime",
        "description": "Adds the InvokeGlobalInferenceGateway and InvokeGlobalInferenceGatewayWithResponseStream APIs for sending inference requests to a SageMaker HyperPod Global Inference Gateway."
    },
    {
        "type": "api-change",
        "category": "Textract",
        "description": "Amazon Textract Insights uses generative AI to split, classify, and extract data from documents with one asynchronous API. Get text, layout, and tables as Markdown, HTML, or CSV, plus summaries and figure captions, and extract the fields you define in a blueprint with confidence scores and locations"
    },
    {
        "type": "api-change",
        "category": "MediaConvert",
        "description": "This release adds support for the DTS-X and DTS audio codecs, AV1 encoding improvements including Fast decode, GOP size in seconds, and temporal adaptive quantization, and Dynamic Multiview for H.264 and H.265 outputs."
    },
    {
        "type": "api-change",
        "category": "Odb",
        "description": "Adds the ListAutonomousDatabaseRefreshableClones and StartAutonomousDatabaseRefresh APIs for listing and refreshing refreshable clones of Autonomous Database Serverless."
    },
    {
        "type": "api-change",
        "category": "ComputeOptimizerAutomation",
        "description": "Adds organization enrollment configurations, which enable Automation and set the organization rule mode for the organization root, organizational units (OUs), and accounts. Organization rules can include and exclude OUs, and recommended actions and automation events can be filtered by OU."
    },
    {
        "type": "feature",
        "category": "Payments",
        "description": "Initial release of AWS Payments API, which lets you view your account balance, invoices, credit memos, and payment instruments."
    },
    {
        "type": "api-change",
        "category": "Inspector2",
        "description": "This release adds runtimeReachability, runtimeReachabilityReason, and purl fields to vulnerable packages in the finding model. It also adds runtimeReachability, runtimeReachabilityReason and purlQualifier package filters for listing findings, suppression rules, and findings reports."
    },
    {
        "type": "api-change",
        "category": "WAFV2",
        "description": "This release adds AI Security AMR configuration and five read-only APIs for AWS WAF API Security events. Use ListEvents and ListEventsByWebACL to list events, GetEvent to get event details including the timeline, and ListEventActors and GetEventActor to view the clients attributed to events"
    },
    {
        "type": "api-change",
        "category": "LambdaMicrovms",
        "description": "AWS Lambda MicroVMs now supports customer managed keys (CMK) in AWS Key Management Service (AWS KMS), enabling you to encrypt Lambda MicroVM data at rest using keys you control."
    },
    {
        "type": "api-change",
        "category": "BedrockAgentCoreControl",
        "description": "Adds responseInterceptionMode and responseStreamingConfiguration to gateway interceptor configurations. Set responseInterceptionMode to STREAM to have the response interceptor process streaming responses from HTTP and inference targets in batches of events."
    },
    {
        "type": "api-change",
        "category": "Omics",
        "description": "Adds the parametersUri field to StartRun, which lets you provide run parameters in a JSON file in Amazon S3 instead of inline. GetRun returns parametersUri for runs started this way."
    },
    {
        "type": "api-change",
        "category": "AgentRegistry",
        "description": "Adds support for the WEBBOT registry record type"
    },
    {
        "type": "api-change",
        "category": "PartnerCentralChannel",
        "description": "Adds MSP program relationships support in AWS Partner Central. Partners can now create, update, list, and delete MSP relationships using the new MSP program type on the CreateProgramManagementAccount, CreateRelationship, UpdateRelationship, and ListRelationships operations."
    },
    {
        "type": "api-change",
        "category": "BedrockRuntime",
        "description": "Amazon Bedrock Runtime adds an optional projectIdentifier parameter to InvokeModel, InvokeModelWithResponseStream, Converse, and ConverseStream, allowing requests to specify a project by ID or ARN."
    },
    {
        "type": "feature",
        "category": "APIPortal",
        "description": "Adds support for API Portal, a new Amazon API Gateway feature that discovers the APIs running behind API Gateway, Application Load Balancer, and CloudFront across an AWS Organization, evaluates their security posture, and publishes documentation portals for them."
    },
    {
        "type": "api-change",
        "category": "MarketplaceDiscovery",
        "description": "AWS Marketplace Discovery adds ListListingAttributes, an API for trust center, case study, and specialization details. SearchListings adds summaries, seller engagements and filters. GetListing and GetProduct return purchase indicators when products cannot be subscribed to or require no subscription."
    },
    {
        "type": "api-change",
        "category": "Backup",
        "description": "This release adds ResourceTypeOptInIncremental to the UpdateRegionSettings request and the DescribeRegionSettings response, so customers can opt in to or out of incremental backups. It currently applies only to Amazon DynamoDB table backups."
    },
    {
        "type": "api-change",
        "category": "NetworkSecurityManager",
        "description": "Adds support for Network Firewall automated internet firewall to Network Security Manager"
    }
]
