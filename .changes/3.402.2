        "type": "api-change",
        "category": "BedrockAgentCoreControl",
        "description": "Adds the ResetTokenVaultKeyMaterial API, which restores a token vault whose customer managed key was deleted by moving it to an AWS owned key. The reset permanently deletes the stored OAuth 2.0 tokens, users must consent again. Adds on-behalf-of token exchange client authentication override option."
    },
    {
        "type": "api-change",
        "category": "ECS",
        "description": "ECS now supports GPU sharing via NVIDIA Multi-Process Service (MPS) on ECS Managed Instances and ECS EC2, allowing multiple ECS tasks to share a single Nvidia GPU for improved utilization."
    },
    {
        "type": "api-change",
        "category": "LicenseManager",
        "description": "AWS License Manager now supports delegate grants for read-only visibility into license distributions. CreateGrant accepts a new GrantType (BuyerGrant or DelegateGrant) and a desired status at distribution time."
    }
