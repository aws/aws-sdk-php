    },
    {
        "type": "api-change",
        "category": "WorkSpaces",
        "description": "Added the NestedVirtualization and EnableEndUserAdvisor self-service permissions. Use them with ModifySelfservicePermissions to turn nested virtualization and End User Advisor on or off for a directory, and view the settings with DescribeWorkspaceDirectories. End User Advisor is on by default."
    },
    {
        "type": "api-change",
