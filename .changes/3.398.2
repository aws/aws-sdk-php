    },
    {
        "type": "api-change",
        "category": "EKS",
        "description": "An optional customer provided prefix used to construct the hostname of the Argo CD server endpoint for EKS Argo CD Capability."
    },
    {
        "type": "api-change",
        "category": "Billing",
