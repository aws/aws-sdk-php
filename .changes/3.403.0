[
    {
        "type": "api-change",
        "category": "AgentRegistryControl",
        "description": "Adds support for OAuth2 Authorization Server Metadata (RFC 8414) discovery URLs in custom JWT authorizer."
    },
    {
        "type": "api-change",
        "category": "QConnect",
        "description": "Adds support for real-time agent assistance and self-service with Amazon Connect Global Resiliency, including cross-Region replication of supported AI agent resources and configurations."
    },
    {
        "type": "feature",
        "category": "AccountAccessRuntime",
        "description": "Adds SDK support for Account Access user portal operations, enabling users to list out and get credentials for role assignments configured in AWS IAM Account Access Manager."
    },
    {
        "type": "api-change",
        "category": "Glue",
        "description": "AWS Glue Spark ETL jobs can now auto-upgrade to the latest version. Set GlueVersion to Auto, then track progress with the AutoVersionStatus field in GetJob. Use StartJobUpgradeAnalysis to approve or decline an upgrade, GetJobUpgradeAnalysis to view details, and StopJobUpgradeAnalysis to stop it."
    },
    {
        "type": "api-change",
        "category": "Route53Domains",
        "description": "Route 53 Domains now supports restoring domains. This release adds the RestoreDomain API to self-serve domain restoration."
    },
    {
        "type": "api-change",
        "category": "DataSync",
        "description": "Adds support for federated identity on Azure Blob Storage and object storage locations, enabling DataSync to authenticate to Azure and Google Cloud Storage using Workload Identity Federation (WIF) over OpenID Connect (OIDC) instead of stored long-lived credentials."
    },
    {
        "type": "api-change",
        "category": "CloudWatchLogs",
        "description": "Adds account-level retention policies with dry run preview and the Essentials log group class to Amazon CloudWatch Logs"
    },
    {
        "type": "api-change",
        "category": "SecurityAgent",
        "description": "Adds support for IAM Identity Center groups as Agent Space members. CreateMembership, DeleteMembership, and ListMemberships now accept the GROUP member type. ListMemberships can filter by USER, GROUP, or ALL, and returns group display name and description."
    },
    {
        "type": "api-change",
        "category": "BedrockAgentRuntime",
        "description": "Amazon Bedrock Managed Knowledge Base now supports an optional mediaId parameter in GetDocumentContent that you can use to retrieve images embedded in source documents."
    },
    {
        "type": "api-change",
        "category": "LambdaMicrovms",
        "description": "AWS Lambda MicroVMs now support the x86-64 CPU architecture, which you can select in addition to ARM64 (Graviton) when launching a MicroVM."
    },
    {
        "type": "api-change",
        "category": "QuickSight",
        "description": "Amazon QuickSight adds APIs to view account service role settings and switch to or replace a customer-managed IAM role."
    },
    {
        "type": "api-change",
        "category": "AppIntegrationsService",
        "description": "This release adds a LastModifiedRegion field to GetApplication and ListApplications so customers can see which Region an application was last modified in."
    },
    {
        "type": "api-change",
        "category": "WAFV2",
        "description": "AWS WAF customers who monetize AI traffic on Web ACLs can now configure payments through connected accounts (Stripe)."
    },
    {
        "type": "api-change",
        "category": "SageMaker",
        "description": "Fixed the ImageDeleted and ImageVersionDeleted waiters to succeed on the ResourceNotFound error returned by DescribeImage and DescribeImageVersion"
    },
    {
        "type": "api-change",
        "category": "BedrockAgentCoreControl",
        "description": "Adds support for OAuth2 Authorization Server Metadata (RFC 8414) discovery URLs in custom JWT authorizer and OAuth2 credential provider configurations."
    }
]
