        "category": "CodeConnections",
        "description": "This release adds Smithy RPC v2 CBOR as an additional protocol alongside the existing AWS JSON 1.0. The SDK will prioritize its most performant protocol."
    },
    {
        "type": "api-change",
        "category": "FMS",
        "description": "This release adds Smithy RPC v2 CBOR as an additional protocol alongside the existing AWS JSON 1.1. The SDK will prioritize its most performant protocol."
    },
    {
        "type": "api-change",
        "category": "Glue",
        "description": "Introduced GetSystemLogsForJobRun and GetSystemLogsForSession APIs, enabling account admins to retrieve system-space logs for FGAC-enabled Glue jobs and sessions."
    },
    {
        "type": "api-change",
        "category": "Translate",
        "description": "This release adds Smithy RPC v2 CBOR as an additional protocol alongside the existing AWS JSON 1.1. The SDK will prioritize its most performant protocol."
    },
    {
        "type": "api-change",
        "category": "Budgets",
        "description": "Adds a product attribute dimension to CreateBudget and UpdateBudget, letting customers filter AWS Budgets costs by structured attributes such as Amazon Bedrock model, provider, inference type, and feature."
    },
    {
        "type": "api-change",
        "category": "Health",
        "description": "This release adds Smithy RPC v2 CBOR as an additional protocol alongside the existing AWS JSON 1.1. The SDK will prioritize its most performant protocol."
    },
    {
        "type": "api-change",
        "category": "EKS",
        "description": "Configurations support for EKS ACK Capabilities, including EnableCrossNamespace and DisableServices configuration."
    },
    {
        "type": "api-change",
        "category": "MediaLive",
        "description": "AWS Elemental MediaLive Workflow Monitor now supports AWS Elemental Inference feeds as a target resource type for CloudWatch alarm templates."
    },
    {
        "type": "api-change",
        "category": "SecurityHub",
        "description": "Release findings export APIs - StartExportJobV2, GetExportJobV2, ListExportJobsV2, and CancelExportJobV2. This supports exporting findings from AWS Security Hub to Amazon S3 bucket."
    },
    {
        "type": "api-change",
        "category": "Lambda",
        "description": "AWS Lambda now supports OAuth 2.0 (OAUTHBEARER), IAM, and IAM with OAUTHBEARER authentication for self-managed Apache Kafka event source mappings, including optional OAuth scope, audience, logical cluster, and identity pool parameters. OAuth 2.0 is also available for Confluent Schema Registry."
    },
    {
        "type": "api-change",
        "category": "OpenSearchService",
        "description": "This release adds a new EncryptionMode option (DISK or NATIVE) to EncryptionAtRestOptions for the CreateDomain and UpdateDomainConfig operations, enabling selection of engine-native index-level encryption on supported Amazon OpenSearch Service domains."
    },
    {
        "type": "api-change",
        "category": "CloudFormation",
        "description": "CloudFormation introduces force rollback, a new opt-in capability that lets your stacks complete a rollback even when an individual resource cannot be reverted. Set ForceRollback on ContinueUpdateRollback and CloudFormation records each resource that fails as skipped, completing the rollback."
    },
    {
        "type": "api-change",
        "category": "SecurityIR",
        "description": "Adds support for retrieving finding-lifecycle metrics for an AWS Security Incident Response membership."
    },
    {
        "type": "api-change",
        "category": "DevOpsAgent",
        "description": "Adds release management associations with private network access to AWS DevOps Agent, and a releaseManagementAssociationId field on GitHub and GitLab associations. This helps release management agents (Release-readiness review and Release Testing) access customer resources that are behind a VPC."
    },
    {
        "type": "api-change",
        "category": "DataZone",
        "description": "Adds support for multi-file notebook import. StartNotebookImport now accepts an s3Files source location with an ordered list of Amazon S3 objects, creating one notebook cell per file, plus a type field to create either a DATA or SQL notebook."
    },
    {
        "type": "api-change",
        "category": "GameLift",
        "description": "Amazon GameLift Servers container fleets now support CPU bursting for game server container groups. The TotalVcpuLimit property of a game server container group definition is now optional. When you omit it, the group has no CPU cap and its containers can burst into unused CPU on the instance."
    },
    {
        "type": "api-change",
        "category": "GuardDuty",
        "description": "Added support for GuardDuty RDS Data Activity Monitoring"
    },
    {
        "type": "api-change",
        "category": "CostExplorer",
        "description": "Adds a product attribute dimension to GetCostAndUsage, GetCostAndUsageWithResources, and GetDimensionValues, letting customers group, filter, and discover Cost Explorer costs by structured attributes such as Amazon Bedrock model, provider, inference type, and feature."
    },
    {
        "type": "enhancement",
        "category": "SESv2",
        "description": "SESV2 DEED - Documentation Update"
    },
    {
        "type": "api-change",
        "category": "EMRServerless",
        "description": "This release adds support for system profile logs for lakeformation enabled Spark connect sessions ."
    },
    {
        "type": "api-change",
        "category": "MarketplaceAgreement",
        "description": "This release adds Smithy RPC v2 CBOR as an additional protocol alongside the existing AWS JSON 1.0. The SDK will prioritize its most performant protocol."
