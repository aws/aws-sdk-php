    },
    {
        "type": "api-change",
        "category": "ARCRegionSwitch",
        "description": "Adds RetryableConflictException to UpdatePlan so AWS SDKs automatically retry updates that conflict with a concurrent change."
    },
    {
        "type": "api-change",
        "category": "S3Tables",
        "description": "Adds support for server access logging for Amazon S3 table buckets with the new PutTableBucketLogging and GetTableBucketLogging APIs."
    },
    {
        "type": "api-change",
        "category": "LakeFormation",
        "description": "Adds support for governing AWS Glue user-defined functions with Lake Formation permissions. This release adds the UserDefinedFunction and AnyResource resources, the EXECUTE permission, and the GetTemporaryGlueFunctionCredentials and GetGlueFunctionSessionContext APIs."
    },
    {
        "type": "api-change",
        "category": "BedrockAgentCoreControl",
